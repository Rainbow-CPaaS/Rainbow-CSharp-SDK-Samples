<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <RootNamespace>AdaptiveCards</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
