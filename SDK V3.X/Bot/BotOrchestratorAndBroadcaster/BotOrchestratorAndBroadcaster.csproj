<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
	<Version>0.10.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Content Update="config\botConfiguration.json" CopyToPublishDirectory="PreserveNewest" CopyToOutputDirectory="PreserveNewest"/>
    <Content Update="config\credentials.json" CopyToPublishDirectory="PreserveNewest" CopyToOutputDirectory="PreserveNewest"/>
    <Content Update="config\exeSettings.json" CopyToPublishDirectory="PreserveNewest" CopyToOutputDirectory="PreserveNewest"/>
    <Content Update="config\labels_EN.json" CopyToPublishDirectory="PreserveNewest" CopyToOutputDirectory="PreserveNewest"/>
    <Content Update="config\labels_FR.json" CopyToPublishDirectory="PreserveNewest" CopyToOutputDirectory="PreserveNewest"/>
    <EmbeddedResource Include="Resources\AdaptiveCards\AC_Example_Data.json" />
    <EmbeddedResource Include="Resources\AdaptiveCards\AC_Example_StreamsSelection.json" />
    <EmbeddedResource Include="Resources\AdaptiveCards\AC_StreamsSelection.json" />
    <EmbeddedResource Include="Resources\AdaptiveCards\AC_TableRow_Broadcaster.json" />
    <EmbeddedResource Include="Resources\labels_EN.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AdaptiveCards.Templating" Version="1.5.0" />
    <ProjectReference Include="..\BotBroadcaster\BotBroadcaster.csproj">
    </ProjectReference>
  </ItemGroup>
</Project>
